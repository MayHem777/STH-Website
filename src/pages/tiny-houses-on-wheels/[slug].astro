---
import { productSchema as buildProductSchema } from '../../lib/schema';
import ComingSoonNote from '../../components/ComingSoonNote.astro';
import { listed } from '../../lib/visible';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import CTAButton from '../../components/CTAButton.astro';
import SpotGallery from '../../components/SpotGallery.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const products = await getCollection('products-thow', ({ data }) => listed(data));
  return products.map((p) => ({ params: { slug: p.id }, props: { product: p } }));
}

const { product } = Astro.props;
const { Content } = await render(product);

const productSchema = buildProductSchema(product.data, Astro.url.href, 'Tiny houses on wheels');

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.sunshinetinyhouses.com.au/' },
    { '@type': 'ListItem', position: 2, name: 'Tiny Houses on Wheels', item: 'https://www.sunshinetinyhouses.com.au/tiny-houses-on-wheels/' },
    { '@type': 'ListItem', position: 3, name: product.data.title, item: Astro.url.href },
  ],
};
import { photo } from '../../lib/photos';
---

<BaseLayout
  title={`${product.data.title} Tiny House on Wheels | Sunshine Tiny Houses`}
  description={product.data.description}
  ogImage={product.data.ogImage ?? photo(product.data.heroImage, `thow/${product.id}/main`).src}
  schema={[productSchema, breadcrumbSchema]}
>

  <Hero
    variant="split"
    kind="Tiny house on wheels"
    title={product.data.title}
    subtitle={product.data.tagline}
    image={product.data.heroImage}
    spotKey={`thow/${product.id}/main`}
    imageAlt={product.data.heroImageAlt ?? product.data.title}
    ctaText="Contact Now"
    ctaHref="/contact/"
    secondaryCtaText="View All Models"
    secondaryCtaHref="/tiny-houses-on-wheels/"
  />
  <ComingSoonNote show={product.data.comingSoon} />

  <section class="section">
    <div class="container product-layout">

      <article class="product-body prose">
        <Content />
      </article>

      <aside class="product-sidebar">
        {product.data.specs && Object.keys(product.data.specs).length > 0 && (
          <div class="spec-card">
            <h2 class="spec-card__title">Specifications</h2>
            <dl class="spec-list">
              {Object.entries(product.data.specs).map(([key, val]) => (
                <>
                  <dt>{key}</dt>
                  <dd>{val as string}</dd>
                </>
              ))}
            </dl>
          </div>
        )}

        {product.data.features && product.data.features.length > 0 && (
          <div class="spec-card">
            <h2 class="spec-card__title">Features</h2>
            <ul class="feature-list">
              {product.data.features.map((f) => <li>{f}</li>)}
            </ul>
          </div>
        )}

        <div class="cta-card">
          <h2>Interested in the {product.data.title}?</h2>
          <p>Get a free, no-obligation quote from our team.</p>
          <CTAButton href="/contact/" variant="light" class="cta-card__btn">Contact Now</CTAButton>
        </div>
      </aside>

    </div>
  </section>

  <SpotGallery prefix={`thow/${product.id}/gallery-`} group="gallery" alts={Object.fromEntries((product.data.gallery ?? []).map((g) => [g.src, g.alt]))} title={`${product.data.title} photos`} alt={`${product.data.title} tiny house on wheels, photo`} />

</BaseLayout>

<style>
.product-layout {
  display: grid;
  grid-template-columns: 1fr 340px;
  gap: 4rem;
  align-items: start;
}

.prose {
  line-height: 1.75;
  font-size: var(--font-size-base);
}

.spec-card {
  background: var(--color-surface);
  border-radius: var(--radius-card);
  padding: 1.5rem;
  margin-bottom: 1.5rem;
}
.spec-card__title {
  font-size: var(--font-size-lg);
  margin-bottom: 1rem;
  padding-bottom: 0.75rem;
  border-bottom: 1px solid var(--color-border);
}
.spec-list {
  display: grid;
  grid-template-columns: auto 1fr;
  gap: 0.5rem 1rem;
}
.spec-list dt { font-weight: 600; font-size: var(--font-size-sm); color: var(--color-text-muted); }
.spec-list dd { font-size: var(--font-size-sm); }

.feature-list {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}
.feature-list li {
  font-size: var(--font-size-sm);
  padding-left: 1.25rem;
  position: relative;
}
.feature-list li::before {
  content: '✓';
  position: absolute;
  left: 0;
  color: var(--color-primary);
  font-weight: 700;
}

.cta-card {
  background: var(--color-primary);
  color: #fff;
  border-radius: var(--radius-card);
  padding: 1.5rem;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}
.cta-card h2 { font-size: var(--font-size-xl); color: #fff; }
.cta-card p { font-size: var(--font-size-sm); color: #fff; opacity: 0.9; }

@media (max-width: 900px) {
  .product-layout {
    grid-template-columns: 1fr;
  }
  .product-sidebar {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }
  .cta-card { grid-column: 1 / -1; }
}
@media (max-width: 600px) {
  .product-sidebar { grid-template-columns: 1fr; }
}
</style>
