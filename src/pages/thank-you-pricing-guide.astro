---
// Where the ad landing pages send a lead whose budget is under $100k (see LeadTracking.astro).
// Wording and prices copied from the live Squarespace page on 2026-10-03; fires no conversion.
import LandingLayout from '../layouts/LandingLayout.astro';
---

<LandingLayout
  title="Thank You: Pricing Guide | Sunshine Tiny Houses"
  description="Thanks for getting in touch. Here is a straight answer on what our modular homes cost."
  canonical="https://www.sunshinetinyhouses.com.au/thank-you-pricing-guide/"
  noindex={true}
>
  <section class="pg">
    <div class="pg__inner">
      <p class="pg__tick" aria-hidden="true">&#10003;</p>
      <h1>Thanks for getting in touch &mdash; here's a straight answer.</h1>
      <p class="pg__lead">
        We appreciate you reaching out. Here's the honest picture on pricing so you can plan with confidence.
      </p>

      <div class="pg__card">
        <p class="pg__eyebrow">Our pricing</p>
        <h2>Our modular range starts from $110k.</h2>
        <p class="pg__range">Studios from $110k &middot; 1-bedroom from $140k &middot; 2-bedroom from $195k.</p>
        <p class="pg__small">
          All prices incl. GST, ex-factory &mdash; delivery, site works and council approvals are quoted
          separately for your block.
        </p>
        <p>
          We know that's above the budget you noted in your enquiry. We'd rather be upfront about that now
          than waste your time with a conversation that doesn't stack up.
        </p>
        <p class="pg__actions">
          <a class="pg__btn" href="https://files.sunshinetinyhouses.com.au/downloads/sth-brochure.pdf">Download the Full Brochure (PDF) &rarr;</a>
          <a class="pg__link" href="/modular-homes/">See Our Range Online &rarr;</a>
        </p>
      </div>

      <div class="pg__card">
        <p class="pg__eyebrow">When the time is right</p>
        <h2>We're still happy to hear from you.</h2>
        <p>
          Budgets change. If you're planning ahead for the next 12&ndash;18 months, or you'd just like to
          understand what's involved so you can save toward a specific target, feel free to reach out directly.
        </p>
        <p>Mitch and Nat answer their own emails. No call centres, no sales scripts.</p>
        <p class="pg__actions">
          <a class="pg__btn" href="mailto:info@sunshinetinyhouses.com.au">Email Us Directly</a>
        </p>
      </div>

      <p class="pg__sign">
        <strong>Sunshine Tiny Houses</strong><br />
        Factory-built modular homes &middot; Noosaville, QLD<br />
        Sunshine Coast &amp; South East Queensland<br />
        Mitch &amp; Nat
      </p>
    </div>
  </section>
</LandingLayout>

<style>
.pg { padding: 3.5rem var(--spacing-container) 4.5rem; background: var(--color-surface); }
.pg__inner { max-width: 680px; margin: 0 auto; }
.pg__tick {
  width: 56px; height: 56px; line-height: 56px; margin: 0 auto 1.25rem; border-radius: 50%;
  background: var(--color-primary); color: #fff; font-size: 1.6rem; text-align: center;
}
.pg h1 { font-size: clamp(1.6rem, 4vw, 2.2rem); text-align: center; margin: 0 0 0.75rem; color: var(--color-text); }
.pg__lead { text-align: center; color: var(--color-text-body); font-size: 1.05rem; margin: 0 0 2rem; }
.pg__card { background: #fff; border: 1px solid var(--color-border); border-radius: 12px; padding: 1.75rem; margin-bottom: 1.25rem; }
.pg__card h2 { font-size: 1.35rem; margin: 0 0 0.6rem; color: var(--color-text); }
.pg__card p { color: var(--color-text-body); line-height: 1.6; margin: 0 0 0.9rem; }
.pg__eyebrow { text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.78rem; font-weight: 700; color: var(--color-primary) !important; margin-bottom: 0.4rem !important; }
.pg__range { font-weight: 600; color: var(--color-text) !important; }
.pg__small { font-size: 0.92rem; color: var(--color-text-muted) !important; }
.pg__actions { display: flex; flex-wrap: wrap; gap: 0.9rem 1.25rem; align-items: center; margin: 1.25rem 0 0 !important; }
.pg__btn { display: inline-block; background: var(--color-primary); color: #fff; font-weight: 600; padding: 0.8rem 1.25rem; border-radius: 8px; text-decoration: none; }
.pg__btn:hover { background: var(--color-primary-hover); }
.pg__link { color: var(--color-primary); font-weight: 600; }
.pg__sign { text-align: center; color: var(--color-text-muted); font-size: 0.95rem; line-height: 1.6; margin-top: 2rem; }
</style>
