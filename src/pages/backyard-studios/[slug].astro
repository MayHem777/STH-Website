---
import { listed } from '../../lib/visible';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import CTAButton from '../../components/CTAButton.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const products = await getCollection('products-class10a', ({ data }) => listed(data));
  return products.map((p) => ({ params: { slug: p.id }, props: { product: p } }));
}

const { product } = Astro.props;
const { Content } = await render(product);

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.data.title,
  description: product.data.description,
  brand: { '@type': 'Brand', name: 'Sunshine Tiny Houses' },
  offers: {
    '@type': 'Offer',
    url: Astro.url.href,
    seller: { '@type': 'Organization', name: 'Sunshine Tiny Houses' },
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.sunshinetinyhouses.com.au/' },
    { '@type': 'ListItem', position: 2, name: 'Backyard Studios', item: 'https://www.sunshinetinyhouses.com.au/backyard-studios/' },
    { '@type': 'ListItem', position: 3, name: product.data.title, item: Astro.url.href },
  ],
};
import { photo } from '../../lib/photos';
---

<BaseLayout
  title={`${product.data.title.startsWith('Backyard') ? product.data.title : `Backyard ${product.data.title}`} QLD | Sunshine Tiny Houses`}
  description={product.data.description}
  ogImage={product.data.ogImage ?? photo(product.data.heroImage, `studio/${product.id}/main`).src}
  schema={[productSchema, breadcrumbSchema]}
>

  <Hero
    variant="split"
    kind="Backyard studio"
    title={product.data.title}
    subtitle={product.data.tagline}
    image={product.data.heroImage}
    spotKey={`studio/${product.id}/main`}
    imageAlt={product.data.heroImageAlt ?? product.data.title}
    ctaText="Contact Now"
    ctaHref="/contact/"
    secondaryCtaText="View All Studios"
    secondaryCtaHref="/backyard-studios/"
  />

  <section class="section">
    <div class="container product-layout">
      <article class="prose"><Content /></article>
      <aside>
        <div class="cta-card">
          <h2>Interested in {product.data.title.toLowerCase()}?</h2>
          <p>Get a free, no-obligation quote from our team.</p>
          <CTAButton href="/contact/" variant="light" class="cta-card__btn">Contact Now</CTAButton>
        </div>
      </aside>
    </div>
  </section>

</BaseLayout>

<style>
.product-layout { display: grid; grid-template-columns: 1fr 300px; gap: 4rem; align-items: start; }
.prose { line-height: 1.75; }
.cta-card { background: var(--color-primary); color: #fff; border-radius: var(--radius-card); padding: 1.5rem; display: flex; flex-direction: column; gap: 0.75rem; }
.cta-card h2 { font-size: var(--font-size-xl); color: #fff; }
.cta-card p { font-size: var(--font-size-sm); color: #fff; opacity: 0.9; }
@media (max-width: 900px) { .product-layout { grid-template-columns: 1fr; } }
</style>
