---
import BaseLayout from '../layouts/BaseLayout.astro';

const PLACE_ID = 'ChIJ_ZsOPnJ5k2sRFUIODm2zP4k';
const API_KEY = import.meta.env.GOOGLE_PLACES_API_KEY;

let reviews = [];
let rating = 5;
let totalRatings = 0;

if (API_KEY) {
  try {
    const res = await fetch(
      `https://maps.googleapis.com/maps/api/place/details/json?place_id=${PLACE_ID}&fields=reviews,rating,user_ratings_total&key=${API_KEY}`
    );
    const data = await res.json();
    reviews = data.result?.reviews ?? [];
    rating = data.result?.rating ?? 5;
    totalRatings = data.result?.user_ratings_total ?? 0;
  } catch (e) {
    console.warn('Google Places fetch failed, using fallback reviews');
  }
}

const toInitials = (name: string) =>
  name.replace(/\(.*?\)/g, '').trim()
      .split(/\s+/)
      .map(w => w[0].toUpperCase() + '.')
      .join(' ');

// Fallback reviews if API key not set or fetch fails
if (reviews.length === 0) {
  reviews = [
    { author_name: 'Zofia Nordqvist', rating: 5, text: "Nat and Mitch were amazing the whole way through the process of designing and building our beautiful double loft tiny home and custom made trailer, we're stoked with the result! If you're thinking of building a tiny home we highly recommend the Sunshine Tiny Houses Crew!" },
    { author_name: 'James Simpson', rating: 5, text: "It was an absolute pleasure working with Nat, Mitch and the team. Nothing was a problem for them to help us achieve our beautiful tiny home. Their attention to detail, input and their after service was fantastic. I have and would highly recommend engaging with Sunshine Tiny Houses for your dream tiny home." },
    { author_name: 'Kellee Myers', rating: 5, text: "Highly recommend Sunshine Tiny Houses. We first approached Nat and Mitch about their design process. We were so impressed with their knowledge and expertise we decided to have them build our Tiny from start to finish. We had a custom 3 bedroom build, and cannot be happier. Thank you guys." },
    { author_name: 'Peter Carr', rating: 5, text: "Mitch and Nat were amazing to deal with, from my initial contact requesting a quote on a custom 9x2.8m Tiny House On Wheels, through the design and construction process and final delivery. I couldn't be any happier with the final result!" },
    { author_name: 'N T', rating: 5, text: "We recently purchased a custom build tiny house on wheels from Nat and Mitch and are thrilled with it. The quality of the finishes, attention to detail and customer service is amazing. Exceptional service and product. Thanks Nat and Mitch." },
  ];
}
import { spot } from '../lib/photos';
const teamPic = spot('about/team', '/images/about-workshop.webp');
---

<BaseLayout
  title="About Us: Noosaville Tiny House Builders | Sunshine Tiny Houses"
  description="QBCC licensed Queensland builder of tiny houses and modular homes. We design, approve, build and deliver, managing council, certifiers and every trade."
  canonical="https://www.sunshinetinyhouses.com.au/about/"
>

  <section class="page-hero">
    <div class="container">
      <p class="eyebrow eyebrow--dark">About Sunshine Tiny Houses</p>
      <h1>A Queensland licensed builder that handles your project <em>from concept to completion</em></h1>
      <p class="page-hero__sub">We design, approve, build and deliver modular homes, granny flats and tiny houses on wheels from our factory in Noosaville. One builder, one contract and one point of contact, from the first sketch to handing you the keys.</p>
      <ul class="hero-badges">
        <li><b>QBCC</b> Licence 15205110</li>
        <li>Master Builders Queensland member</li>
        <li>Fully licensed &amp; insured</li>
        <li>20+ years building in Queensland</li>
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container about-intro">
      <div class="about-intro__text">
        <p class="eyebrow">Who we are</p>
        <h2>Mitch and Nat, and a team of local tradespeople</h2>
        <p>Sunshine Tiny Houses is run by Mitch and Nat Croft. Mitch is a builder with more than 20 years of building and carpentry experience on the Sunshine Coast, and Nat looks after design and keeps every client informed from start to finish.</p>
        <p>We are a licensed building company, not a kit supplier or a reseller. Every home is built by our own team in our Noosaville factory, to your design, and we stay responsible for it all the way through approvals, delivery and installation.</p>
        <div class="facts">
          <div class="fact"><strong>2020</strong><span>Founded on the Sunshine Coast</span></div>
          <div class="fact"><strong>20+</strong><span>Years of local building experience</span></div>
          <div class="fact"><strong>Australia</strong><span>Wide delivery available</span></div>
        </div>
      </div>
      <img class="about-intro__img" src={teamPic.src} data-spot={teamPic.n} width="1079" height="1065" alt="Sunshine Tiny Houses team at work on a tiny house in the Noosaville factory" loading="lazy" />
    </div>
  </section>

  <section class="section section--surface">
    <div class="container">
      <p class="eyebrow">How we work</p>
      <h2>We manage every step, so you don't have to</h2>
      <p class="lead">Most people building a tiny house or modular home have never dealt with councils, certifiers or a building site before. You don't need to. We run the whole project and tell you when we need a decision or a signature.</p>
      <ol class="steps">
        <li class="step"><h3>Concept &amp; design</h3><p>We start with how you want to live, then design the home around you and your block. Custom layouts, your choice of finishes, and plans you approve before anything is built.</p></li>
        <li class="step"><h3>Site check &amp; clear quote</h3><p>We look at your property, access, services and your council's rules, then give you a clear quote covering the build, delivery, installation and approvals.</p></li>
        <li class="step"><h3>Approvals handled</h3><p>We prepare and lodge the paperwork with the building certifier and council, and engage the engineers, town planner and energy assessor where your project needs them.</p></li>
        <li class="step"><h3>Factory build</h3><p>Your home is built under cover in our Noosaville factory by licensed tradespeople, with the floor system and framing inspected and certified by our structural engineer.</p></li>
        <li class="step"><h3>Delivery &amp; installation</h3><p>We organise transport, cranage and site works, set the home on its footings or site, and have licensed plumbers and electricians connect it to services.</p></li>
        <li class="step"><h3>Certified handover</h3><p>Final inspections and certification, a walk-through of your new home, and the keys in your hand. We are still here after handover if you need us.</p></li>
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container coord">
      <div>
        <p class="eyebrow">One point of contact</p>
        <h2>Everyone your project needs, coordinated by us</h2>
        <p>A home on your block involves a long list of approvals, consultants and trades. Instead of you chasing each one, we book them, brief them and make sure their work lines up with the build.</p>
        <p class="callout">Your only role is to make the decisions and sign where we ask you to. We handle everything else.</p>
      </div>
      <ul class="who">
        <li>Council approvals</li>
        <li>Private building certifier</li>
        <li>Structural &amp; civil engineers</li>
        <li>Town planner</li>
        <li>Energy assessor</li>
        <li>Plumbing approval</li>
        <li>Licensed plumbers &amp; drainers</li>
        <li>Licensed electricians</li>
        <li>Certified waterproofing</li>
        <li>Septic design (where needed)</li>
        <li>Transport &amp; crane</li>
        <li>Site works &amp; connections</li>
      </ul>
    </div>
  </section>

  <section class="section licensed">
    <div class="container">
      <p class="eyebrow eyebrow--dark">Why it matters</p>
      <h2>Built by a licensed Queensland building company</h2>
      <div class="about-pillars">
        <div class="pillar"><h3>QBCC licensed</h3><p>We hold a Queensland Building and Construction Commission licence (15205110). You are dealing with a builder who is accountable for the work, not a middleman.</p></div>
        <div class="pillar pillar--mbq"><h3>Master Builders member</h3><p>We are a proud member of Master Builders Queensland, the industry body that holds its members to a code of ethics and keeps them up to date with building standards and contracts.</p><img src="/images/badges/mbq-proud-member-white.png" alt="Master Builders Queensland Proud Member" width="150" height="94" loading="lazy" /></div>
        <div class="pillar"><h3>Built to the code</h3><p>Our modular homes are designed and certified as Class 1a dwellings under the Building Code of Australia, and every home is built by skilled, licensed tradespeople.</p></div>
        <div class="pillar"><h3>Quality over quantity</h3><p>We are not a production line. Each home is built to last a lifetime, with the care and attention to detail our clients keep mentioning in their reviews.</p></div>
      </div>
    </div>
  </section>

  <section class="section section--dark">
    <div class="container">
      <p class="eyebrow eyebrow--dark">What our clients say</p>
      <h2>Rated {rating} Stars &mdash; {totalRatings > 0 ? `${totalRatings} Google Reviews` : 'Google Reviews'}</h2>
      <div class="reviews-grid">
        {reviews.map((r) => (
          <div class="review-card">
            <p class="review-card__stars">{'★'.repeat(r.rating)}</p>
            <blockquote>"{r.text}"</blockquote>
            <p class="review-card__author">— {toInitials(r.author_name)} &nbsp;·&nbsp; Google Review</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container about-cta">
      <h2>Let's talk about your project</h2>
      <p>Tell us what you have in mind and where you want to put it. We'll tell you honestly what's possible, what it involves and what it costs.</p>
      <div class="about-cta__btns">
        <a href="/contact/" class="btn btn--primary">Get in touch</a>
        <a href="tel:0753158365" class="btn btn--outline">(07) 5315 8365</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
.page-hero {
  background: var(--color-banner);
  color: #fff;
  padding: 4.5rem 0 3.5rem;
}
.page-hero h1 { color: #fff; max-width: 820px; font-size: var(--font-size-5xl); }
.page-hero h1 em { font-style: normal; color: var(--color-accent); }
.page-hero__sub { color: rgba(255,255,255,.78); margin-top: 1rem; font-size: 1.1rem; max-width: 680px; }
.eyebrow--dark { color: var(--color-accent); background: rgba(200,169,110,.12); }
.hero-badges { list-style: none; padding: 0; margin: 1.75rem 0 0; display: flex; flex-wrap: wrap; gap: .6rem; }
.hero-badges li { border: 1px solid rgba(255,255,255,.25); border-radius: 99px; padding: .45rem 1rem; font-size: .9rem; font-weight: 600; }
.hero-badges b { color: var(--color-accent); }

h2 { margin-bottom: 1rem; }
.lead { color: var(--color-text-body); max-width: 720px; font-size: 1.05rem; }

/* Intro */
.about-intro { display: grid; grid-template-columns: 1.1fr 1fr; gap: 3rem; align-items: center; }
.about-intro__text p + p { margin-top: 1rem; }
.about-intro__img { width: 100%; height: auto; border-radius: 14px; display: block; }
.facts { display: grid; grid-template-columns: repeat(3, 1fr); gap: .75rem; margin-top: 1.75rem; }
.fact { background: var(--color-surface); border-radius: 12px; padding: 1rem .75rem; text-align: center; }
.fact strong { display: block; font-size: 1.5rem; font-weight: 800; color: var(--color-primary); line-height: 1.1; font-family: var(--font-heading); }
.fact span { font-size: .82rem; color: var(--color-text-body); }

/* Steps */
.steps { list-style: none; padding: 0; margin: 2.25rem 0 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.1rem; counter-reset: step; }
.step { background: #fff; border: 1px solid var(--color-border); border-radius: 14px; padding: 1.6rem 1.4rem; }
.step::before { counter-increment: step; content: counter(step); display: inline-flex; align-items: center; justify-content: center; width: 38px; height: 38px; border-radius: 50%; background: var(--color-primary); color: #fff; font-weight: 800; margin-bottom: .9rem; }
.step h3 { font-size: 1.15rem; margin-bottom: .5rem; }
.step p { font-size: .95rem; color: var(--color-text-body); }

/* Coordination */
.coord { display: grid; grid-template-columns: 1fr 1.2fr; gap: 3rem; align-items: start; }
.coord p + p { margin-top: 1rem; }
.who { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: 1fr 1fr; gap: .6rem; }
.who li { background: var(--color-surface); border-radius: 10px; padding: .75rem .9rem .75rem 2.5rem; position: relative; font-weight: 600; font-size: .95rem; }
.who li::before { content: ""; position: absolute; left: 15px; top: 50%; width: 12px; height: 7px; border-left: 3px solid var(--color-primary); border-bottom: 3px solid var(--color-primary); transform: translateY(-70%) rotate(-45deg); }
.callout { border-left: 4px solid var(--color-accent); padding: .25rem 0 .25rem 1rem; font-weight: 600; }

/* Licensed */
.licensed { background: var(--color-primary); color: #fff; }
.licensed h2, .licensed h3 { color: #fff; }
.about-pillars { display: grid; grid-template-columns: repeat(4, 1fr); gap: 2rem; margin-top: 2rem; }
.pillar--mbq img { width: 140px; height: auto; margin-top: 1.25rem; padding: 4px 0; } /* white version on the dark band (MBQ style guide) */
.pillar h3 { margin-bottom: .6rem; }
.pillar p { color: rgba(255,255,255,.85); }

/* Reviews */
.reviews-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; margin-top: 2rem; }
.reviews-grid .review-card:nth-child(4) { grid-column: 1 / 2; }
.reviews-grid .review-card:nth-child(5) { grid-column: 2 / 3; }
.review-card { background: rgba(255,255,255,.07); border: 1px solid rgba(255,255,255,.12); border-radius: 12px; padding: 1.5rem; }
.review-card__stars { color: var(--color-accent); letter-spacing: 2px; margin-bottom: .75rem; }
.review-card blockquote { font-style: italic; font-size: .92rem; line-height: 1.75; color: rgba(255,255,255,.85); margin-bottom: 1rem; }
.review-card__author { font-size: .8rem; color: rgba(255,255,255,.55); font-weight: 600; }

/* CTA */
.about-cta { text-align: center; }
.about-cta p { color: var(--color-text-body); margin: 0 auto 2rem; max-width: 600px; }
.about-cta__btns { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }
.btn { display: inline-block; padding: .9rem 2rem; border-radius: 8px; font-weight: 700; font-size: 1rem; font-family: var(--font-heading); cursor: pointer; transition: background .2s, transform .15s; text-align: center; }
.btn--primary { background: var(--color-primary); color: #fff; }
.btn--primary:hover { background: var(--color-primary-hover); transform: translateY(-2px); }
.btn--outline { background: transparent; color: var(--color-primary); border: 2px solid var(--color-primary); }
.btn--outline:hover { background: var(--color-primary); color: #fff; }

@media (max-width: 900px) {
  .about-intro, .coord { grid-template-columns: 1fr; gap: 2rem; }
  .steps, .about-pillars { grid-template-columns: 1fr 1fr; }
  .reviews-grid { grid-template-columns: repeat(2, 1fr); }
  .reviews-grid .review-card:nth-child(4),
  .reviews-grid .review-card:nth-child(5) { grid-column: auto; }
}
@media (max-width: 600px) {
  .steps, .about-pillars, .who, .reviews-grid { grid-template-columns: 1fr; }
  .fact strong { font-size: 1.2rem; }
}
</style>
