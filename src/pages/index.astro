---
import { listed } from '../lib/visible';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import CTAButton from '../components/CTAButton.astro';
import { getCollection } from 'astro:content';
import { FOUNDED_YEAR } from '../config/site';
import { formatPrice, EX_FACTORY_NOTE } from '../lib/price';
import { spot, photo } from '../lib/photos';
import { roomsLine } from '../lib/rooms';
import { modularHref, rangeIds } from '../lib/modular';

const thowProducts = (await getCollection('products-thow', ({ data }) => listed(data)))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);

const allModularProducts = (await getCollection('products-modular', ({ data }) => listed(data)))
  .sort((a, b) => a.data.order - b.data.order);

const modularStandalone = allModularProducts
  .filter((p) => !p.data.bedrooms && !p.data.range)
  .map((p) => ({ order: p.data.order, title: p.data.title, href: `/modular-homes/${p.id}/` }));

const modularBedroomCounts = [...new Set(allModularProducts.filter((p) => p.data.bedrooms).map((p) => p.data.bedrooms))].sort();
const modularBedroomLinks = modularBedroomCounts.map((count) => {
  const variants = allModularProducts.filter((p) => p.data.bedrooms === count);
  return {
    order: Math.min(...variants.map((p) => p.data.order)),
    title: `${count} Bedroom`,
    href: `/modular-homes/${count}-bedroom/`,
  };
});

const modularProducts = [...modularStandalone, ...modularBedroomLinks]
  .sort((a, b) => a.order - b.order)
  .slice(0, 4);

// Office and Ensuite are utility rooms, not studios (Mitch, 2026-10-17)
const UTILITY_ROOMS = ['office', 'ensuite'];

// Every priced modular model, cheapest first, linking to its own page
const modularRanges = rangeIds(allModularProducts); // the Cabin range page: its models are listed instead
const pricedModular = allModularProducts
  .filter((p) => p.data.priceFrom && !modularRanges.has(p.id))
  .sort((a, b) => (a.data.priceFrom ?? 0) - (b.data.priceFrom ?? 0))
  .map((p) => ({
    title: p.data.title,
    rooms: roomsLine(p.id, p.data.specs),
    description: p.data.tagline ?? p.data.description,
    href: modularHref(p.id, p.data),
    image: p.data.heroImage,
    spotKey: `modular/${p.id}/main`,
    badge: UTILITY_ROOMS.includes(p.id) || p.data.range === 'office' ? 'Utility room' : 'Class 1a',
    imageAlt: p.data.heroImageAlt,
    price: `From ${formatPrice(p.data.priceFrom!)}`,
    meta: p.data.area,
  }));

const processSteps = [
  { title: 'Choose a design', text: 'Pick one of our layouts, modify one to suit, or have us design from scratch. We look at your site, access, zoning and overlays first.' },
  { title: 'Approvals and certification', text: 'A private certifier handles building and plumbing approval. Engineering is designed from your soil test and wind rating.' },
  { title: 'We build it in our factory', text: 'Your home is built under cover in Noosaville while site works and footings are prepared on your land.' },
  { title: 'Install, connections and handover', text: 'We transport and install the finished home, connect services and walk you through every detail.' },
];

const doorThow = spot('home/door-thow', '/images/thow-dark-on-site.webp');
const doorModular = spot('home/door-modular', '/images/models/rio-ext.webp');

// Tiny houses: same cards as the modular range, cheapest turn-key first, custom build last
// (Mitch 2026-10-21: the side-scrolling strip hid most designs and showed no prices).
const turnKey = (v?: string) => Number((v ?? '').replace(/[^0-9]/g, '')) || Infinity;
const thowCards = (await getCollection('products-thow', ({ data }) => listed(data)))
  .sort((a, b) => turnKey(a.data.specs?.['Turn Key from']) - turnKey(b.data.specs?.['Turn Key from']) || a.data.order - b.data.order)
  .map((p) => {
    const sp = p.data.specs ?? {};
    return {
      title: p.data.title,
      rooms: sp.Sleeps ? `Sleeps ${sp.Sleeps}${sp.Bedroom ? ` · ${({ 'Ground floor': 'ground-floor bedroom', 'Ground floor + loft': 'bedroom + loft' } as Record<string, string>)[sp.Bedroom] ?? sp.Bedroom.toLowerCase()}` : ''}` : undefined,
      description: p.data.tagline ?? p.data.description,
      href: `/tiny-houses-on-wheels/${p.id}/`,
      image: p.data.heroImage,
      spotKey: `thow/${p.id}/main`,
      badge: p.data.badge,
      imageAlt: p.data.heroImageAlt,
      price: sp['Turn Key from'] ? `Turn key from ${sp['Turn Key from'].replace(' incl. GST', '')}` : undefined,
      meta: sp.Length ?? sp['Build length'],
      comingSoon: p.data.comingSoon,
    };
  });

const class10aProducts = (await getCollection('products-class10a', ({ data }) => listed(data)))
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Sunshine Tiny Houses | Queensland Modular Home Builders"
  description="Modular homes, granny flats and tiny houses on wheels, built in Noosaville and delivered across Queensland. QBCC licensed, Master Builders member. Free quote."
>

  <!-- Hero: two doors, modular homes first (Mitch 2026-10-17: modular homes lead throughout) -->
  <section class="home-hero">
    <div class="container">
      <p class="home-hero__eyebrow">Sunshine Tiny Houses · Noosaville, Queensland</p>
      <h1 class="home-hero__title">Modular homes and tiny houses on wheels, <em>built by a licensed Queensland builder</em></h1>
      <p class="home-hero__sub">Designed with you, built in our Noosaville factory and delivered anywhere in Australia. We handle the whole project, from the first sketch to handing you the keys.</p>
      <p class="home-hero__ask">Explore our two ranges of products</p>
      <div class="doors">
        <a class="door" href="/modular-homes/">
          <div class="door__ph">
            <img src={doorModular.src} data-spot={doorModular.n} alt="A Sunshine Tiny Houses modular home with a timber deck" width="1400" height="1050" loading="eager" />
            <span class="door__tag">Class 1a</span>
          </div>
          <div class="door__body">
            <h2>Modular homes &amp; granny flats</h2>
            <p class="door__c1a">Every modular home is Class 1a</p>
            <p>Certified as a <strong>Class 1a dwelling</strong>, the same building class as a standard house. A permanent home for your block, built in our factory, then craned in, installed and connected to services.</p>
            <span class="door__cta">Explore modular homes <span aria-hidden="true">&rarr;</span></span>
          </div>
        </a>
        <a class="door" href="/tiny-houses-on-wheels/">
          <div class="door__ph">
            <img src={doorThow.src} data-spot={doorThow.n} alt="A Sunshine Tiny Houses tiny house on wheels on its trailer" width="1400" height="1050" loading="eager" fetchpriority="high" />
            <span class="door__tag">6 m to 10 m</span>
          </div>
          <div class="door__body">
            <h2>Tiny houses on wheels</h2>
            <p>A complete home on a road-registrable trailer we build ourselves. Live in it, rent it out or take it with you when you move.</p>
            <span class="door__cta">Explore tiny houses <span aria-hidden="true">&rarr;</span></span>
          </div>
        </a>
      </div>
      <ul class="home-hero__trust">
        <li>QBCC Licence 15205110</li>
        <li>Master Builders Queensland member</li>
        <li>5-star Google reviews</li>
        <li>Building on the Sunshine Coast for 20+ years</li>
        <li>Australia-wide delivery</li>
      </ul>
    </div>
  </section>

  <!-- Modular range with prices -->
  <section class="section priced-range">
    <div class="container">
      <div class="eyebrow">Modular range</div>
      <h2>Every model, with its price</h2>
      <p class="priced-range__intro"><strong>Every modular home is a certified Class 1a dwelling</strong>, the same building class as a standard house. The range runs from studio cabins to two-bedroom homes, plus utility rooms like an office or ensuite, whose building class depends on your council. Each page has the floor plan and the full inclusions list.</p>
      <div class="priced-range__grid">
        {pricedModular.map((p) => (
          <ProductCard {...p} />
        ))}
      </div>
      <p class="priced-range__note">Prices include GST. {EX_FACTORY_NOTE}</p>
    </div>
  </section>

  <!-- How it works -->
  <section class="section section--surface process">
    <div class="container">
      <div class="eyebrow">How it works</div>
      <h2>Your journey to a modular house</h2>
      <ol class="process__steps">
        {processSteps.map((step, i) => (
          <li>
            <span class="process__num" aria-hidden="true">{i + 1}</span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </li>
        ))}
      </ol>
      <div class="process__btns">
        <CTAButton href="/modular-homes/our-process/">Our full Class 1a modular process</CTAButton>
        <CTAButton href="/delivery/" variant="secondary">Delivery and installation</CTAButton>
      </div>
    </div>
  </section>

  <!-- Tiny houses on wheels: same cards as the modular range -->
  <section class="section priced-range thow-range">
    <div class="container">
      <div class="thow-range__head">
        <div>
          <div class="eyebrow">Tiny houses on wheels</div>
          <h2>Find your tiny house</h2>
          <p class="priced-range__intro">Proven designs from 6 m to 10 m long, each one customised to suit you, or a custom design from a blank page.</p>
        </div>
        <a class="thow-range__more" href="/tiny-houses-on-wheels/">See all tiny houses &rarr;</a>
      </div>
      <div class="priced-range__grid">
        {thowCards.map((p) => (
          <ProductCard {...p} />
        ))}
      </div>
      <p class="priced-range__note">Prices include GST.</p>
    </div>
  </section>

  <!-- Class 10a promo section -->
  <section class="section class10a-promo">
    <div class="container">
      <div class="class10a-promo__header">
        <div>
          <div class="eyebrow">Class 10a Structures</div>
          <h2>Backyard Studios</h2>
          <p>Not looking for a full home? Our backyard studios are the perfect addition to any property — offices, saunas, and utility rooms built to the same quality standard.</p>
        </div>
        <CTAButton href="/backyard-studios/" variant="secondary">View Studios</CTAButton>
      </div>
      <div class="class10a-grid">
        {class10aProducts.map((p) => (
          <ProductCard
            title={p.data.title}
            description={p.data.description}
            href={`/backyard-studios/${p.id}/`}
            image={p.data.heroImage}
            spotKey={`studio/${p.id}/main`}
            imageAlt={p.data.heroImageAlt}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Trust bar -->
  <section class="section--sm trust-bar">
    <div class="container">
      <ul class="trust-list" role="list">
        <li class="trust-list__logo">
          <img src="/images/badges/mbq-proud-member.png" alt="Master Builders Queensland Proud Member" width="150" height="94" loading="lazy" />
        </li>
        <li>
          <strong>QBCC Licensed</strong>
          <span>#15205110</span>
        </li>
        <li>
          <strong>Queensland Built</strong>
          <span>Noosaville, QLD</span>
        </li>
        <li>
          <strong>Tiny Home Specialists</strong>
          <span>Since {FOUNDED_YEAR}</span>
        </li>
        <li>
          <strong>Finance Available</strong>
          <span>Flexible options</span>
        </li>
      </ul>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="section section--dark cta-section">
    <div class="container cta-section__inner">
      <h2>Ready to start your tiny home journey?</h2>
      <p>Get a free, no-obligation quote from Queensland's trusted tiny home builder.</p>
      <CTAButton href="/contact/" variant="ghost">Contact Now</CTAButton>
    </div>
  </section>

</BaseLayout>

<style>
.priced-range h2, .process h2 { margin-block: 0.375rem 0.75rem; }
.priced-range__intro { color: var(--color-text-muted); margin-bottom: 2rem; }
.priced-range__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; }
.priced-range__note { margin-top: 1.5rem; font-size: var(--font-size-sm); color: var(--color-text-muted); }
.process__steps { list-style: none; display: grid; grid-template-columns: repeat(4, 1fr); gap: 2rem; margin-block: 2rem; }
.process__steps li { display: flex; flex-direction: column; gap: 0.5rem; }
.process__num { width: 2.5rem; height: 2.5rem; border-radius: 50%; background: var(--color-primary); color: #fff; font-weight: 700; display: flex; align-items: center; justify-content: center; }
.process__steps h3 { font-size: var(--font-size-xl); }
.process__steps p { color: var(--color-text-muted); line-height: 1.6; font-size: var(--font-size-sm); }
@media (max-width: 1100px) { .priced-range__grid, .process__steps { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 600px) { .priced-range__grid, .process__steps { grid-template-columns: 1fr; } }
.product-lines__grid {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: stretch;
}
.product-line-divider {
  width: 1px;
  background-color: var(--color-border);
  align-self: stretch;
  margin-inline: 3rem;
}
.product-line-card {
  display: flex;
  flex-direction: column;
  gap: 1rem;
  padding-block: 1rem;
}
.product-line-card > :global(.btn) {
  margin-top: auto;
  align-self: flex-start;
}
.product-line-card__eyebrow {
  font-size: var(--font-size-xs);
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--color-accent-text);
}
.product-line-card__title {
  font-size: var(--font-size-3xl);
}
.product-line-card__desc {
  color: var(--color-text-muted);
  line-height: 1.6;
}
.product-line-card__models {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 0.375rem;
}
.product-line-card__models a {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-size: var(--font-size-sm);
  font-weight: 500;
  color: var(--color-text);
  transition: color var(--transition-fast);
}
.product-line-card__models a:hover { color: var(--color-primary); }
.model-length {
  font-size: var(--font-size-xs);
  color: var(--color-text-muted);
  background-color: var(--color-surface);
  padding: 0.125rem 0.375rem;
  border-radius: 2px;
}
.product-line-card__models li:last-child a {
  color: var(--color-primary);
  font-weight: 700;
  margin-top: 0.25rem;
}

.eyebrow {
  font-size: var(--font-size-xs);
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--color-accent-text);
  margin-bottom: 0.5rem;
}
.class10a-promo__header {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 2rem;
  margin-bottom: 2.5rem;
}
.class10a-promo__header h2 { margin-block: 0.375rem 0.75rem; }
.class10a-promo__header p {
  color: var(--color-text-muted);
  max-width: 560px;
  line-height: 1.6;
}
.class10a-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.5rem;
}

.trust-bar { border-block: 1px solid var(--color-border); }
.trust-list {
  display: flex;
  justify-content: space-around;
  flex-wrap: wrap;
  gap: 1.5rem;
  list-style: none;
  text-align: center;
}
.trust-list li { display: flex; flex-direction: column; gap: 0.25rem; }
.trust-list { align-items: center; }
.trust-list__logo img { width: 150px; height: auto; padding: 6px; } /* full-colour logo on white, clear space kept (MBQ style guide) */
.trust-list strong { font-size: var(--font-size-base); font-family: var(--font-heading); }
.trust-list span { font-size: var(--font-size-sm); color: var(--color-text-muted); }

.cta-section__inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 1.25rem;
}
.cta-section__inner h2 { color: var(--color-text-on-dark); }
.cta-section__inner p {
  color: rgba(255,255,255,0.8);
  font-size: var(--font-size-lg);
  max-width: 480px;
}

@media (max-width: 900px) {
  .product-lines__grid { grid-template-columns: 1fr; }
  .product-line-divider {
    width: 100%;
    height: 1px;
    margin-inline: 0;
    margin-block: 2rem;
  }
  .class10a-promo__header { flex-direction: column; align-items: flex-start; }
  .class10a-grid { grid-template-columns: 1fr 1fr; }
}
@media (max-width: 600px) {
  .class10a-grid { grid-template-columns: 1fr; }
}

/* ── Home hero: two doors ─────────────────────────────── */
.home-hero { background: var(--color-banner); color: #fff; padding: 3.5rem 0 3rem; }
.home-hero__eyebrow { font-size: var(--label-size); font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--color-accent); margin-bottom: .75rem; }
.home-hero__title { color: #fff; font-size: var(--font-size-5xl); max-width: 900px; line-height: 1.1; text-wrap: balance; }
.home-hero__title em { font-style: normal; color: var(--color-accent); }
.home-hero__sub { color: rgba(255,255,255,.78); font-size: var(--font-size-lg); max-width: 680px; margin-top: 1rem; }
.home-hero__ask { margin: 2.25rem 0 .9rem; font-weight: 700; font-size: var(--font-size-sm); letter-spacing: .08em; text-transform: uppercase; color: rgba(255,255,255,.6); }
.doors { display: grid; grid-template-columns: 1fr 1fr; gap: 1.1rem; }
.door { display: flex; flex-direction: column; border-radius: 18px; overflow: hidden; background: #262624; border: 1px solid rgba(255,255,255,.08); color: #fff; text-decoration: none; transition: transform .25s, border-color .25s; }
.door:hover { transform: translateY(-4px); border-color: var(--color-accent-border); }
.door__ph { position: relative; aspect-ratio: 16 / 10; overflow: hidden; background: #2a2a2a; }
.door__ph img { width: 100%; height: 100%; object-fit: cover; transition: transform .6s ease; }
.door:hover .door__ph img { transform: scale(1.04); }
.door__body p.door__c1a { flex: none; margin: 0 0 .6rem; color: var(--color-accent); font-weight: 800; font-size: .85rem; letter-spacing: .06em; text-transform: uppercase; }
.door__body p strong { color: #fff; }
.door__tag { position: absolute; right: 1.1rem; top: 1.1rem; background: var(--color-accent); color: var(--color-text); font-weight: 800; font-size: .9rem; letter-spacing: .08em; text-transform: uppercase; padding: .3rem .7rem; border-radius: 99px; }
.door__body { padding: 1.5rem 1.6rem 1.6rem; display: flex; flex-direction: column; align-items: flex-start; flex: 1; }
.door__body h2 { color: #fff; font-size: clamp(1.45rem, 2.6vw, 2rem); margin-bottom: .5rem; }
.door__body p { color: rgba(255,255,255,.8); max-width: 460px; flex: 1; }
.door__cta { display: inline-flex; gap: .5rem; margin-top: 1.1rem; background: #fff; color: var(--color-text); font-weight: 700; padding: .7rem 1.25rem; border-radius: 8px; transition: background .2s; }
.door:hover .door__cta { background: var(--color-accent); }
.home-hero__trust { list-style: none; padding: 0; margin: 1.9rem 0 0; display: flex; flex-wrap: wrap; gap: .6rem 1.75rem; color: rgba(255,255,255,.82); font-weight: 600; font-size: .95rem; }
.home-hero__trust li { display: flex; align-items: center; gap: .5rem; }
.home-hero__trust li::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: var(--color-accent); flex: none; }

/* ── Tiny house range (same grid as the modular range) ── */
.thow-range__head { display: flex; justify-content: space-between; align-items: flex-end; gap: 1.25rem; flex-wrap: wrap; }
.thow-range__more { font-weight: 700; color: var(--color-primary); border-bottom: 2px solid var(--color-accent); white-space: nowrap; margin-bottom: 2rem; }

@media (max-width: 720px) {
  .home-hero { padding: 2.5rem 0 2.25rem; }
  .doors { grid-template-columns: 1fr; }
  .door__body { padding: 1.25rem; }
}
@media (prefers-reduced-motion: reduce) {
  .door, .door__ph img { transition: none; }
  .door:hover, .door:hover .door__ph img { transform: none; }
}
.process__btns { display: flex; gap: 1rem; flex-wrap: wrap; }
</style>
