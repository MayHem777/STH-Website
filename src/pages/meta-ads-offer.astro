---
// Meta ad landing page: the live Squarespace gist's page, copied 2026-10-17 into
// src/landing/meta.html. Edit that file. Photos are numbered spots (see PHOTOS.md).
import fs from 'node:fs';
import path from 'node:path';
import LandingLayout from '../layouts/LandingLayout.astro';
import { spot } from '../lib/photos';

const raw = fs.readFileSync(path.resolve('src/landing/meta.html'), 'utf8');
const html = raw
  .replace(/src="__SPOT_([^_"]+(?:_[^_"]+)*)__"/g, (_, key) => { const s = spot(key); return `src="${s.src}" data-spot="${s.n ?? ''}"`; })
  .replace(/__SPOTURL_([a-z0-9/-]+)__/g, (_, key) => spot(key).src ?? '')
  .replace(/__SPOTN_([a-z0-9/-]+)__/g, (_, key) => String(spot(key).n ?? ''));
---
<LandingLayout
  title={"Free Property Assessment — Sunshine Tiny Houses"}
  description={"Your block could be working for you. We handle design, council approvals, build and delivery of granny flats. Free assessment, no obligation."}
  noindex={true}
  ownHeader={true}
>
  <Fragment set:html={html} />
</LandingLayout>
