---
import { listed } from '../../../lib/visible';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Hero from '../../../components/Hero.astro';
import ProductCard from '../../../components/ProductCard.astro';
import { getCollection } from 'astro:content';
import { formatPrice } from '../../../lib/price';

const products = (await getCollection('products-modular', ({ data }) => listed(data) && data.bedrooms === 1))
  // Cheapest first (Mitch 2026-10-17)
  .sort((a, b) => (a.data.priceFrom ?? Infinity) - (b.data.priceFrom ?? Infinity) || a.data.order - b.data.order);
import { roomsLine } from '../../../lib/rooms';
---

<BaseLayout
  title="1 Bedroom Modular Homes Queensland | Sunshine Tiny Houses"
  description="Browse all of our 1-bedroom modular home models. QBCC-licensed, Class 1a compliant, delivered and installed across Queensland."
>

  <Hero
    title="1 Bedroom Modular Homes"
    subtitle="Your own personal sanctuary. Browse all of our 1-bedroom modular home models below."
    ctaText="Contact Now"
    ctaHref="/contact/"
    secondaryCtaText="All Modular Homes"
    secondaryCtaHref="/modular-homes/"
  />

  <section class="section">
    <div class="container">
      <div class="products-grid">
        {products.map((p) => (
          <ProductCard
            headingLevel={2}
            comingSoon={p.data.comingSoon}
            title={p.data.title}
            description={p.data.description}
            href={`/modular-homes/1-bedroom/${p.id}/`}
            image={p.data.heroImage}
            spotKey={`modular/${p.id}/main`}
            imageAlt={p.data.heroImageAlt ?? p.data.title}
            badge={p.data.badge}
            price={p.data.priceFrom ? `From ${formatPrice(p.data.priceFrom)}` : undefined}
            meta={[p.data.area, p.data.size].filter(Boolean).join(' · ') || undefined}
            rooms={roomsLine(p.id, p.data.specs)}
          />
        ))}
      </div>
    </div>
  </section>

</BaseLayout>

<style>
.products-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1.5rem;
}
@media (max-width: 1100px) { .products-grid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 600px) { .products-grid { grid-template-columns: 1fr; } }
</style>
