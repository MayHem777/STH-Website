---
import TurnKey from '../../components/TurnKey.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import ProductCard from '../../components/ProductCard.astro';
import { getCollection } from 'astro:content';
import { formatPrice, EX_FACTORY_NOTE } from '../../lib/price';

const allProducts = (await getCollection('products-modular', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);

const standaloneCards = allProducts
  .filter((p) => !p.data.bedrooms)
  .map((p) => ({
    id: p.id,
    order: p.data.order,
    title: p.data.title,
    description: p.data.description,
    href: `/modular-homes/${p.id}/`,
    heroImage: p.data.heroImage,
    spotKey: `modular/${p.id}/main`,
    heroImageAlt: p.data.heroImageAlt ?? p.data.title,
    badge: ['office', 'ensuite'].includes(p.id) ? 'Utility room' : (p.data.badge ?? 'Class 1a'),  // Office + Ensuite are utility rooms, not studios (Mitch 2026-10-17)
    price: p.data.priceFrom ? `From ${formatPrice(p.data.priceFrom)}` : undefined,
    priceNum: p.data.priceFrom ?? Infinity,
    meta: p.data.area,
    rooms: roomsLine(p.id, p.data.specs),
  }));

const bedroomCounts = [...new Set(allProducts.filter((p) => p.data.bedrooms).map((p) => p.data.bedrooms))].sort();
const bedroomCards = bedroomCounts.map((count) => {
  const variants = allProducts.filter((p) => p.data.bedrooms === count);
  return {
    id: `${count}-bedroom`,
    order: Math.min(...variants.map((p) => p.data.order)),
    title: `${count} Bedroom`,
    description: `${variants.length} model${variants.length === 1 ? '' : 's'}: ${variants.map((p) => p.data.title).join(', ')}`,
    href: `/modular-homes/${count}-bedroom/`,
    heroImage: variants[0].data.heroImage,
    spotKey: `modular/${variants[0].id}/main`,
    heroImageAlt: variants[0].data.heroImageAlt ?? `${count} bedroom modular home`,
    badge: 'Class 1a',
    price: `From ${formatPrice(Math.min(...variants.map((p) => p.data.priceFrom ?? Infinity)))}`,
    priceNum: Math.min(...variants.map((p) => p.data.priceFrom ?? Infinity)),
    meta: undefined,
    rooms: (() => { const baths = [...new Set(variants.map((v) => ((v.data.specs?.Bathrooms ?? '').match(/\d+/) ?? [''])[0]).filter(Boolean))].sort(); return `${count} bed · ${baths.join('–')} bath`; })(),
  };
});

// Cheapest first (Mitch 2026-10-17); models without a price go last
const products = [...standaloneCards, ...bedroomCards].sort((a, b) => a.priceNum - b.priceNum || a.order - b.order);
import { roomsLine } from '../../lib/rooms';
---

<BaseLayout
  title="Modular Homes & Granny Flats QLD | Sunshine Tiny Houses"
  description="QBCC-licensed modular homes and granny flats built and delivered across Queensland. Class 1a compliant, finance available. Free quote from Noosaville QLD."
>

  <Hero
    title="Modular Homes & Granny Flats"
    subtitle="Every modular home we build is a certified Class 1a dwelling, the same building class as a standard house, with about two weeks on site, start to finish. Perfect as a granny flat, secondary dwelling or standalone home."
    ctaText="Contact Now"
    ctaHref="/contact/"
    secondaryCtaText="Finance Options"
    secondaryCtaHref="/finance/"
  />

  <section class="section">
    <div class="container">
      <div class="products-grid">
        {products.map((p) => (
          <ProductCard
            title={p.title}
            description={p.description}
            href={p.href}
            image={p.heroImage}
            spotKey={p.spotKey}
            imageAlt={p.heroImageAlt}
            badge={p.badge}
            price={p.price}
            meta={p.meta}
            rooms={p.rooms}
          />
        ))}
      </div>
      <p class="price-note">Prices include GST. {EX_FACTORY_NOTE}</p>
    </div>
  </section>

  <TurnKey />

</BaseLayout>

<style>
.price-note { margin-top: 1.5rem; font-size: var(--font-size-sm); color: var(--color-text-muted); }
.products-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1.5rem;
}
@media (max-width: 1100px) { .products-grid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 600px) { .products-grid { grid-template-columns: 1fr; } }
</style>
