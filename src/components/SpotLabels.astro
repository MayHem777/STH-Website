---
// Preview builds only: puts each photo spot's number on top of the photo, so Nat can
// match photos to spots (see PHOTOS.md). Production (main) builds render nothing.
import { SHOW_SPOT_NUMBERS } from '../lib/photos';
---
{SHOW_SPOT_NUMBERS && (
  <>
    <style is:global>
      .sth-spot-label { position: absolute; z-index: 9999; pointer-events: none; background: #E8372C; color: #fff; font: 800 15px/1 system-ui, sans-serif; padding: 6px 9px; border-radius: 0 0 8px 0; box-shadow: 0 2px 8px rgba(0,0,0,.35); }
      .sth-spot-banner { position: fixed; z-index: 10000; left: 12px; bottom: 12px; background: #E8372C; color: #fff; font: 700 13px/1.3 system-ui, sans-serif; padding: 8px 12px; border-radius: 8px; box-shadow: 0 2px 10px rgba(0,0,0,.3); }
      .sth-spot-banner a { color: #fff; text-decoration: underline; }
      [data-spot-empty] { background: repeating-linear-gradient(45deg, #ece6dc 0 14px, #e3dccf 14px 28px) !important; }
    </style>
    <div class="sth-spot-banner">Preview: red numbers are photo spots · <a href="/photo-spots/">full list</a></div>
    <script is:inline>
    (function () {
      var labels = [];
      function draw() {
        labels.forEach(function (l) { l.remove(); }); labels = [];
        document.querySelectorAll('[data-spot]').forEach(function (el) {
          var n = el.getAttribute('data-spot'); if (!n) return;
          var r = el.getBoundingClientRect(); if (r.width < 20 || r.height < 20) return;
          if (r.left < -1 || r.left > document.documentElement.clientWidth - 40) return; // scrolled out of a sideways strip
          var l = document.createElement('div'); l.className = 'sth-spot-label';
          l.textContent = String(n).padStart(3, '0');
          l.style.left = (r.left + window.scrollX) + 'px'; l.style.top = (r.top + window.scrollY) + 'px';
          document.body.appendChild(l); labels.push(l);
        });
      }
      var t; function later() { clearTimeout(t); t = setTimeout(draw, 80); }
      window.addEventListener('load', draw); window.addEventListener('resize', later);
      document.addEventListener('scroll', later, true);
      document.addEventListener('DOMContentLoaded', draw);
    })();
    </script>
  </>
)}
