---
export interface Props {
  title: string;
  subtitle?: string;
  ctaText?: string;
  ctaHref?: string;
  secondaryCtaText?: string;
  secondaryCtaHref?: string;
  image?: string;
  imageAlt?: string;
  overlay?: boolean;
  centered?: boolean;
  spotKey?: string;
  // 'split': text left, the whole photo right, not cropped or darkened (model pages, Mitch 2026-10-20).
  // The full-width banner crops a 3:2 photo to about 4:1 on a wide screen and shades it.
  variant?: 'banner' | 'split';
  // What the model is, shown small under the name inside the h1 (e.g. "Tiny house on wheels")
  kind?: string;
}

const {
  title,
  subtitle,
  ctaText = 'Contact Now',
  ctaHref = '/contact/',
  secondaryCtaText,
  secondaryCtaHref,
  image,
  imageAlt = '',
  overlay = true,
  centered = false,
  spotKey,
  variant = 'banner',
  kind,
} = Astro.props;
import { photo } from '../lib/photos';
const pic = photo(image, spotKey);
const split = variant === 'split' && !!pic.src;
---

{split ? (
<section class="hero hero--split">
  <div class="container hero__split">
    <div class="hero__content">
      <h1 class="hero__title">{title}{kind && <span class="hero__kind">{kind}</span>}</h1>
      {subtitle && <p class="hero__subtitle">{subtitle}</p>}
      <div class="hero__actions">
        <a href={ctaHref} class="btn btn--primary">{ctaText}</a>
        {secondaryCtaText && secondaryCtaHref && (
          <a href={secondaryCtaHref} class="btn btn--outline">{secondaryCtaText}</a>
        )}
      </div>
    </div>
    <a class="hero__media" href={pic.src} data-lightbox="gallery">
      <img src={pic.src} data-spot={pic.n} alt={imageAlt} width="1200" height="800" loading="eager" fetchpriority="high" />
    </a>
  </div>
</section>
) : (
<section class:list={['hero', { 'hero--has-image': pic.src, 'hero--centered': centered }]}>
  {pic.src && (
    <div class="hero__bg" aria-hidden="true">
      <img src={pic.src} data-spot={pic.n} alt={imageAlt} width="1440" height="700" loading="eager" fetchpriority="high" />
      {overlay && <div class="hero__overlay"></div>}
    </div>
  )}
  <div class="container hero__content">
    <h1 class="hero__title">{title}</h1>
    {subtitle && <p class="hero__subtitle">{subtitle}</p>}
    <div class="hero__actions">
      <a href={ctaHref} class="btn btn--primary">{ctaText}</a>
      {secondaryCtaText && secondaryCtaHref && (
        <a href={secondaryCtaHref} class="btn btn--ghost">{secondaryCtaText}</a>
      )}
    </div>
  </div>
</section>
)}

<style>
.hero {
  position: relative;
  min-height: 520px;
  display: flex;
  align-items: center;
  background-color: var(--color-surface);
}

/* No photo (listing pages): brand-green banner like the rest of the site (Mitch 2026-10-20, was cream) */
.hero:not(.hero--has-image):not(.hero--split) { background-color: var(--color-banner); color: #fff; min-height: 0; }
.hero:not(.hero--has-image):not(.hero--split) .hero__content { padding-block: 4rem 3.5rem; }
.hero:not(.hero--has-image):not(.hero--split) .hero__title { color: #fff; }
.hero:not(.hero--has-image):not(.hero--split) .hero__subtitle { color: rgba(255, 255, 255, 0.96); opacity: 1; }
.hero:not(.hero--has-image):not(.hero--split) .btn--primary { background-color: #fff; border-color: #fff; color: var(--color-primary); }
.hero:not(.hero--has-image):not(.hero--split) .btn--primary:hover { background-color: #f5ecd8; border-color: #f5ecd8; }
.hero:not(.hero--has-image):not(.hero--split) .btn--ghost { color: #fff; border-color: #fff; }

.hero--has-image {
  min-height: 620px;
  color: var(--color-text-on-dark);
}

.hero--centered .hero__content {
  text-align: center;
  align-items: center;
}

.hero__bg {
  position: absolute;
  inset: 0;
  overflow: hidden;
}
.hero__bg img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.hero__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to right, rgba(0,0,0,0.7) 0%, rgba(0,0,0,0.38) 100%);
}

/* global h1/p colour rules would otherwise override the inherited on-dark
   colour, leaving near-black text on top of photos */
.hero--has-image .hero__title,
.hero--has-image .hero__subtitle {
  color: var(--color-text-on-dark);
  text-shadow: 0 1px 4px rgba(0, 0, 0, 0.45);
}

.hero__content {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
  padding-block: 5rem;
  max-width: 680px;
}

.hero--centered .hero__content {
  max-width: 800px;
  margin-inline: auto;
}

.hero__title {
  font-size: clamp(2rem, 5vw, 3.5rem);
  line-height: 1.1;
}

.hero__subtitle {
  font-size: var(--font-size-lg);
  opacity: 0.9;
  max-width: 560px;
  line-height: 1.55;
}

.hero__actions {
  display: flex;
  gap: 1rem;
  flex-wrap: wrap;
}

.btn {
  display: inline-block;
  padding: 0.875rem 2rem;
  border-radius: var(--radius-btn);
  font-size: var(--font-size-sm);
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  text-align: center;
  transition: background-color var(--transition-fast), color var(--transition-fast), border-color var(--transition-fast);
  border: 2px solid transparent;
}
.btn--primary {
  background-color: var(--color-primary);
  color: #fff;
  border-color: var(--color-primary);
}
.btn--primary:hover {
  background-color: var(--color-primary-hover);
  border-color: var(--color-primary-hover);
}
.btn--ghost {
  background-color: transparent;
  color: currentColor;
  border-color: currentColor;
}
.btn--ghost:hover {
  background-color: rgba(255,255,255,0.15);
}

.hero--split { min-height: 0; padding-block: 2.5rem 3rem; }
.hero__split { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.35fr); gap: 3rem; align-items: center; }
.hero--split .hero__content { padding-block: 0; max-width: none; }
.hero__kind { display: block; margin-top: 0.6rem; font-size: var(--font-size-sm); font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-primary); }
.hero--split .hero__subtitle { color: var(--color-text-muted); opacity: 1; }
.hero__media { display: block; border-radius: var(--radius-card); overflow: hidden; background: var(--color-border); }
.hero__media img { display: block; width: 100%; height: auto; aspect-ratio: 3 / 2; object-fit: cover; transition: transform 0.3s; }
.hero__media:hover img { transform: scale(1.02); }
.btn--outline { background-color: transparent; color: var(--color-primary); border-color: var(--color-primary); }
.btn--outline:hover { background-color: var(--color-primary); color: #fff; }
@media (max-width: 900px) {
  .hero--split { padding-block: 0 2rem; }
  .hero__split { grid-template-columns: 1fr; gap: 1.5rem; padding-inline: 0; }
  .hero--split .hero__content { padding-inline: var(--container-padding); }
  .hero__media { order: -1; border-radius: 0; }
}

@media (max-width: 600px) {
  .hero__actions {
    flex-direction: column;
  }
  .btn {
    text-align: center;
    width: 100%;
  }
}
</style>
