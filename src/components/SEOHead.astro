---
import { SITE_NAME, FOUNDED_YEAR } from '../config/site';
import { spot } from '../lib/photos';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
  schema?: object | object[];
}

// Drive base URL from astro.config.mjs `site` so there's one source of truth.
const SITE_URL = (Astro.site?.href ?? 'https://www.sunshinetinyhouses.com.au/').replace(/\/$/, '');
const DEFAULT_OG_IMAGE = spot('site/share', '/og-default.jpg').src ?? '/og-default.jpg';

const {
  title,
  description,
  canonical,
  ogImage = DEFAULT_OG_IMAGE,
  noindex = false,
  schema,
} = Astro.props;

// Link previews (Facebook, LinkedIn, texts) need a full URL
const ogImageURL = new URL(ogImage, SITE_URL).href;
const canonicalURL = canonical ?? new URL(Astro.url.pathname, SITE_URL).href;

// Build-time noindex: only CF Pages main-branch builds get indexed.
// The _middleware.js also patches the tag at runtime for *.pages.dev hosts.
const isProd = import.meta.env.CF_PAGES_BRANCH === 'main';
const isNoindex = noindex || !isProd;
const fullTitle = title.includes(SITE_NAME) ? title : `${title} | ${SITE_NAME}`;

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  '@id': `${SITE_URL}/#business`,
  name: 'Sunshine Tiny Houses',
  url: SITE_URL,
  // Plain-words summary of who we are: AI answer engines quote this when asked "who builds tiny houses / modular homes on the Sunshine Coast"
  description: 'Queensland licensed builder (QBCC 15205110) in Noosaville on the Sunshine Coast. Designs and builds Class 1a modular homes, granny flats, tiny houses on wheels and backyard studios in its own factory, and delivers Australia-wide.',
  foundingDate: String(FOUNDED_YEAR),
  taxID: 'ABN 40 270 427 080',
  founder: [
    { '@type': 'Person', name: 'Mitch Croft', jobTitle: 'Builder and managing director', url: `${SITE_URL}/about/` },
    { '@type': 'Person', name: 'Nat Croft', jobTitle: 'Design and client communication', url: `${SITE_URL}/about/` },
  ],
  areaServed: [
    { '@type': 'AdministrativeArea', name: 'Sunshine Coast, Queensland' },
    { '@type': 'State', name: 'Queensland' },
    { '@type': 'Country', name: 'Australia' },
  ],
  knowsAbout: ['Modular homes', 'Granny flats', 'Secondary dwellings', 'Tiny houses on wheels', 'Class 1a dwellings', 'Backyard studios', 'Off-grid tiny homes'],
  logo: `${SITE_URL}/images/logo.png`,
  image: new URL(DEFAULT_OG_IMAGE, SITE_URL).href,
  telephone: '+61753158365',
  email: 'hello@sunshinetinyhouses.com.au',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '24 Venture Drive',
    addressLocality: 'Noosaville',
    addressRegion: 'QLD',
    postalCode: '4566',
    addressCountry: 'AU',
  },
  memberOf: { '@type': 'Organization', name: 'Master Builders Queensland', url: 'https://www.mbqld.com.au' },
  // Mon–Fri 7:30 am – 4 pm (Mitch 2026-10-21, matches Google Business Profile); Saturday by appointment (Mitch, 2026-10-17)
  openingHoursSpecification: [{
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
    opens: '07:30',
    closes: '16:00',
  }],
  geo: {
    '@type': 'GeoCoordinates',
    // Google Business Profile pin, 24 Venture Dr (checked on Maps 2026-10-21; was -26.394, 153.073, about 3 km off)
    latitude: -26.4077,
    longitude: 153.0426,
  },
  sameAs: [
    'https://www.instagram.com/sunshinetinyhouses',
    'https://www.facebook.com/sunshinetinyhouses',
    'https://www.youtube.com/@SunshineTinyHouses',
  ],
  hasCredential: [
    { '@type': 'EducationalOccupationalCredential', credentialCategory: 'QBCC Licence #15205110' },
  ],
};

// Tidy page schemas for Google (SEO audit 2026-10-20): image URLs absolute; every Product gets the
// page's main photo; an Offer without a price is dropped (Google reports it as an error).
function tidy(o: any): any {
  if (!o || typeof o !== 'object') return o;
  const t = { ...o };
  if (typeof t.image === 'string') t.image = new URL(t.image, SITE_URL).href;
  if (t['@type'] === 'Product') {
    if (!t.image) t.image = ogImageURL;
    if (t.offers && !Array.isArray(t.offers) && t.offers.price == null) delete t.offers;
  }
  return t;
}
// Names the site as one entity, so engines tie every page to the same business
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE_URL}/#website`,
  name: SITE_NAME,
  url: `${SITE_URL}/`,
  inLanguage: 'en-AU',
  publisher: { '@id': `${SITE_URL}/#business` },
};
const schemas = [
  localBusinessSchema,
  websiteSchema,
  ...(Array.isArray(schema) ? schema : schema ? [schema] : []).map(tidy),
];
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />
<!-- max-snippet/max-image-preview: let Google (incl. AI Overviews) quote and show as much as it likes -->
<meta name="robots" content={isNoindex ? 'noindex, nofollow' : 'index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1'} />
<meta name="geo.region" content="AU-QLD" />
<meta name="geo.placename" content="Noosaville" />
<meta name="theme-color" content="#5c6a5b" />

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:image" content={ogImageURL} />
<meta property="og:locale" content="en_AU" />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageURL} />

<!-- Favicons -->
<!-- Tab icon: the STH "tiny" mark (same as the Squarespace site), not the Astro default -->
<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />

<!-- Schema.org structured data -->
{schemas.map((s) => (
  <script type="application/ld+json" set:html={JSON.stringify(s)} />
))}
