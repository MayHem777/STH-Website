---
// A range listing page (like 1 Bedroom) with a card per model; each model has its own page.
// Range text and main photo come from src/content/products-modular/<range>.md; models are the files with range: "<range>".
import { listed } from '../lib/visible';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from './Hero.astro';
import ProductCard from './ProductCard.astro';
import { getCollection, getEntry, render } from 'astro:content';
import { formatPrice, EX_FACTORY_NOTE } from '../lib/price';
import { roomsLine } from '../lib/rooms';
import { photo } from '../lib/photos';

import { RANGES } from '../lib/modular';
export interface Props { range: string; }
const R = RANGES[Astro.props.range];
const range = (await getEntry('products-modular', Astro.props.range))!;
const { Content } = await render(range);
const products = (await getCollection('products-modular', ({ data }) => listed(data) && data.range === Astro.props.range))
  .sort((a, b) => (a.data.priceFrom ?? Infinity) - (b.data.priceFrom ?? Infinity) || a.data.order - b.data.order);
---

<BaseLayout
  title={`${R.seoTitle} | Sunshine Tiny Houses`}
  description={range.data.description}
  ogImage={range.data.ogImage ?? photo(range.data.heroImage, `modular/${range.id}/main`).src}
>

  <Hero
    variant="split"
    title={R.plural}
    subtitle={products.length > 1 ? `${range.data.tagline} Browse our ${products.length} ${R.plural.toLowerCase()} below.` : range.data.tagline}
    image={range.data.heroImage}
    spotKey={`modular/${range.id}/main`}
    imageAlt={range.data.heroImageAlt ?? R.plural}
    ctaText="Contact Now"
    ctaHref="/contact/"
    secondaryCtaText="All Modular Homes"
    secondaryCtaHref="/modular-homes/"
  />

  <section class="section">
    <div class="container">
      <div class="range-intro prose"><Content /></div>
      <div class="products-grid">
        {products.map((p) => (
          <ProductCard
            comingSoon={p.data.comingSoon}
            title={p.data.title}
            description={p.data.tagline ?? p.data.description}
            href={`/modular-homes/${range.id}/${p.id}/`}
            image={p.data.heroImage}
            spotKey={`modular/${p.id}/main`}
            imageAlt={p.data.heroImageAlt ?? p.data.title}
            badge={p.data.badge ?? R.badge}
            price={p.data.priceFrom ? `From ${formatPrice(p.data.priceFrom)}` : undefined}
            meta={[p.data.area, p.data.size].filter(Boolean).join(' · ') || undefined}
            rooms={roomsLine(p.id, p.data.specs)}
          />
        ))}
      </div>
      <p class="range-note">Prices include GST. {EX_FACTORY_NOTE}</p>
    </div>
  </section>

</BaseLayout>

<style>
.range-intro { max-width: 70ch; margin-bottom: 2rem; line-height: 1.75; }
.range-intro :global(h2) { display: none; } /* the hero already names the range */
.products-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
.range-note { margin-top: 1.5rem; font-size: var(--font-size-sm); color: var(--color-text-muted); }
@media (max-width: 1100px) { .products-grid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 600px) { .products-grid { grid-template-columns: 1fr; } }
</style>
